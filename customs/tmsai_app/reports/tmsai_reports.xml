<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Paper Format for TMS Reports -->
        <record id="paperformat_tmsai" model="report.paperformat">
            <field name="name">TMS A4</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">2970</field>
            <field name="page_width">2100</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">35</field>
            <field name="dpi">90</field>
        </record>
        
        <!-- Transport Request Report -->
        <report
            id="report_tmsai_transport_request"
            model="tmsai.transport.request"
            string="Transport Request"
            report_type="qweb-pdf"
            name="tmsai_app.report_tmsai_transport_request"
            file="tmsai_app.report_tmsai_transport_request"
            print_report_name="'Transport Request - %s' % (object.name)"
            paperformat="paperformat_tmsai"
            groups="tmsai.group_user,tmsai.group_planner,tmsai.group_billing,tmsai.group_manager"
        />
        
        <!-- Freight Order Report -->
        <report
            id="report_tmsai_freight_order"
            model="tmsai.freight.order"
            string="Freight Order"
            report_type="qweb-pdf"
            name="tmsai_app.report_tmsai_freight_order"
            file="tmsai_app.report_tmsai_freight_order"
            print_report_name="'Freight Order - %s' % (object.name)"
            paperformat="paperformat_tmsai"
            groups="tmsai.group_planner,tmsai.group_manager"
        />
        
        <!-- Freight Settlement Report -->
        <report
            id="report_tmsai_freight_settlement"
            model="tmsai.freight.settlement"
            string="Freight Settlement"
            report_type="qweb-pdf"
            name="tmsai_app.report_tmsai_freight_settlement"
            file="tmsai_app.report_tmsai_freight_settlement"
            print_report_name="'Freight Settlement - %s' % (object.name)"
            paperformat="paperformat_tmsai"
            groups="tmsai.group_billing,tmsai.group_manager"
        />
    </data>
</odoo>